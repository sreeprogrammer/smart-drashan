# Copy these settings into .env for local OTP testing.
# Configure the same phone number and code in Supabase Auth > Phone > Test OTPs.
# The development UI shows this code only for this test phone; production never exposes it.
VITE_DEV_OTP_TEST_PHONE=+919876543210
VITE_DEV_OTP_TEST_CODE=123456

# Local-only admin demo credentials. Put real values in .env.local, not in this file.
LOCAL_DEMO_ADMIN_USERNAME=
LOCAL_DEMO_ADMIN_PASSWORD=
LOCAL_DEMO_ADMIN_SECRET_CODE=
